{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/contact-us/", "destination": "/contact", "permanent": true },
    { "source": "/our-services/", "destination": "/our-services", "permanent": true },
    { "source": "/about-us", "destination": "/", "permanent": true },
    { "source": "/about-us/", "destination": "/", "permanent": true },
    { "source": "/gallery", "destination": "/", "permanent": true },
    { "source": "/gallery/", "destination": "/", "permanent": true },
    { "source": "/lawn-mowing", "destination": "/our-services", "permanent": true },
    { "source": "/lawn-mowing/", "destination": "/our-services", "permanent": true },
    { "source": "/garden-design-planting/", "destination": "/our-services", "permanent": true },
    { "source": "/yard-maintaince/", "destination": "/our-services", "permanent": true },
    { "source": "/decorative-plants/", "destination": "/our-services", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)\\.(html|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
